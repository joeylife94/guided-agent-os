HOST_PORT=8701
RAG_REBUILD_ON_START=true
RAG_EMBEDDING_PROVIDER=bge_m3
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Optional local OpenAI-compatible model endpoint.
# The service remains healthy and returns retrieved context when unavailable.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_TIMEOUT=5

# Leave empty for same-origin Tailnet/API-doc usage.
CORS_ALLOW_ORIGINS=
